---
import Layout from "../../layouts/Layout.astro";
import Navigation from "@/components/Navigation";
import Footer from "@/components/Footer.astro";
import PostList from "@/components/PostList.astro";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
const current = posts.filter((p) => !p.data.archived);
const older = posts.filter((p) => p.data.archived);
---

<Layout
    title="Writing | John Alvin Ambalong"
    description="Posts about building and deploying Rails apps, by John Alvin Ambalong."
>
    <div class="dt-bg min-h-screen">
        <Navigation client:load pathname={Astro.url.pathname} />

        <main id="main-content">
            <section
                class="dt-surface pt-32 pb-12 px-6"
                style="border-bottom: 1px solid var(--dt-border)"
            >
                <div class="w-full max-w-4xl mx-auto">
                    <p class="dt-eyebrow mb-3">Writing</p>
                    <h1 class="dt-display mb-4 page-h1">All <em>posts</em></h1>
                    <p class="dt-body">
                        Things I've built and problems I got stuck on. Newest first.
                        <a href="/rss.xml" class="subscribe-link ml-2">RSS feed</a>
                    </p>
                </div>
            </section>

            <section class="dt-bg dt-section px-6">
                <div class="w-full max-w-4xl mx-auto">
                    <h2 class="sr-only">Recent posts</h2>
                    <PostList posts={current} />

                    {
                        older.length > 0 && (
                            <>
                                <h2 class="dt-display dt-h2 mt-16 mb-6">Older posts</h2>
                                <PostList posts={older} compact />
                            </>
                        )
                    }
                </div>
            </section>
        </main>

        <Footer />
    </div>
</Layout>
