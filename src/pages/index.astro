---
import Layout from '../layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Hero from '@/components/Hero.astro';
import PostList from '@/components/PostList.astro';
import Subscribe from '@/components/Subscribe.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import Footer from '@/components/Footer.astro';
import { getPosts } from '@/lib/posts';

const latest = (await getPosts()).slice(0, 3);
---

<Layout>
  <Navigation client:load pathname={Astro.url.pathname} />

  <main id="main-content">
    <Hero />

    <section id="writing" class="dt-surface dt-section">
      <div class="w-full max-w-4xl mx-auto px-6">
        <p class="dt-eyebrow mb-3">Writing</p>
        <h2 class="dt-display dt-h2 mb-8">Latest <em>posts</em></h2>
        <PostList posts={latest} />
        <p class="mt-8"><a href="/blog/" class="dt-btn-ghost">All posts</a></p>
      </div>
    </section>

    <Subscribe variant="section" />

    <ProjectsSection />
  </main>

  <Footer />
</Layout>
