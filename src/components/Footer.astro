---
import Icon from './Icon.astro';
import { SITE } from '../config/site';

const year = new Date().getFullYear();
const links = [
  { href: SITE.github, label: 'GitHub', icon: 'github', external: true },
  { href: SITE.x, label: 'X', icon: 'x', external: true },
  { href: '/rss.xml', label: 'RSS', icon: 'rss', external: false },
  { href: `mailto:${SITE.email}`, label: 'Email', icon: 'mail', external: false },
] as const;
---

<footer class="dt-bg py-10" style="border-top: 1px solid var(--dt-border)">
  <div class="w-full max-w-4xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
        <span class="dt-mono">{SITE.name} © {year}</span>
        <span class="dt-mono">Built with Astro</span>
        <a href="/privacy/" class="dt-mono subscribe-link">Privacy</a>
      </div>

      <div class="flex items-center gap-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
              aria-label={l.label}
              class="dt-icon-link"
            >
              <Icon name={l.icon} size={16} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
