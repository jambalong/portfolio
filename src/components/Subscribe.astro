---
import { SITE } from '../config/site';

interface Props {
  variant: 'section' | 'inline';
}
const { variant } = Astro.props;
const hasForm = SITE.kitFormId !== '';
const action = `https://app.kit.com/forms/${SITE.kitFormId}/subscriptions`;
const inputId = `email-${variant}`;
---

{
  variant === 'section' ? (
    <section id="subscribe" class="dt-bg dt-section">
      <div class="w-full max-w-4xl mx-auto px-6">
        <div class="section-head" style="margin-bottom: 20px">
          <div>
            <p class="dt-eyebrow mb-3">Email</p>
            <h2 class="dt-display dt-h2">
              New posts by <em>email</em>
            </h2>
          </div>
          <span class="section-num" aria-hidden="true">02</span>
        </div>
        <p class="dt-body mb-8 max-w-xl">
          I send an email when I publish a new post. If I release something I've built, I'll mention it there too.
        </p>
        {hasForm ? (
          <>
            <form method="post" action={action} class="subscribe-form">
              <label for={inputId} class="sr-only">Email address</label>
              <input id={inputId} type="email" name="email_address" required autocomplete="email" placeholder="you@example.com" class="subscribe-input" />
              <button type="submit" class="dt-btn-green">Subscribe</button>
            </form>
            <p class="dt-mono mt-4 max-w-xl">
              Your address goes to Kit, which sends the emails (see the <a href="/privacy/" class="subscribe-link">privacy page</a>). You can unsubscribe from any email. There is also an <a href="/rss.xml" class="subscribe-link">RSS feed</a>.
            </p>
          </>
        ) : (
          <p class="dt-body">
            You can follow new posts with the <a href="/rss.xml" class="subscribe-link">RSS feed</a>.
          </p>
        )}
      </div>
    </section>
  ) : (
    <aside class="subscribe-inline">
      <h2 class="dt-display subscribe-inline-h2">Get the next post by email</h2>
      {hasForm ? (
        <>
          <form method="post" action={action} class="subscribe-form">
            <label for={inputId} class="sr-only">Email address</label>
            <input id={inputId} type="email" name="email_address" required autocomplete="email" placeholder="you@example.com" class="subscribe-input" />
            <button type="submit" class="dt-btn-green">Subscribe</button>
          </form>
          <p class="dt-mono mt-4">
            Your address goes to Kit, which sends the emails (see the <a href="/privacy/" class="subscribe-link">privacy page</a>). You can unsubscribe from any email. There is also an <a href="/rss.xml" class="subscribe-link">RSS feed</a>.
          </p>
        </>
      ) : (
        <p class="dt-body">
          You can follow new posts with the <a href="/rss.xml" class="subscribe-link">RSS feed</a>.
        </p>
      )}
    </aside>
  )
}

<script>
  // Submit in the background so visitors stay on this site. If anything fails,
  // fall back to the normal form post, which takes them to Kit's page.
  document.querySelectorAll<HTMLFormElement>('.subscribe-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        let data: { status?: string } | null = null;
        try {
          data = await response.json();
        } catch {}
        if (!response.ok || data?.status === 'error') throw new Error('Subscribe failed');
        const message = document.createElement('p');
        message.className = 'dt-body';
        message.setAttribute('role', 'status');
        message.tabIndex = -1;
        message.textContent = 'Check your email to confirm your subscription. It can take a minute to arrive.';
        form.replaceWith(message);
        message.focus();
      } catch {
        form.submit();
      }
    });
  });
</script>
