---
import '@/styles/global.css';
import { SITE } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
  ogImage = "/og-image.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).toString(),
  ogType = "website",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": SITE.name,
  "url": SITE.url,
  "sameAs": [SITE.github, SITE.linkedin, SITE.x, SITE.youtube],
  "description": description,
  "knowsAbout": ["Ruby on Rails", "PostgreSQL", "Hotwire", "Docker", "Kamal", "DevOps", "Web Security"]
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="darkreader-lock" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Alvin Ambalong" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="John Alvin Ambalong" href={new URL('rss.xml', Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:alt" content="John Alvin Ambalong, ambalong.dev" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ambalong.dev" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:creator" content={SITE.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <noscript>
      <style>
        /* Without JavaScript the phone menu button does nothing, so show the links. */
        nav[aria-label="Main"] { flex-wrap: wrap; gap: 8px; }
        .nav-desktop { display: flex !important; flex-wrap: wrap; }
        .nav-mobile-btn { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    {
      import.meta.env.PROD && SITE.goatcounterCode !== '' && (
        <script
          data-goatcounter={`https://${SITE.goatcounterCode}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>